# Ignore data (it lives on Zenodo, not in the Docker build)
remote/01_data_replication/
scripts/01_data_extraction/
scripts/02_data_preparation/
scripts/99_archive/
scripts/claude_reports/

# Ignore your local computer's R package installations
renv/library/
renv/staging/
renv/cache/

# Ignore local R session history and user settings
.Rhistory
.RData
.Rproj.user/

# Ignore Git tracking files (Docker doesn't need your version history)
.git/
.gitignore

# Ignore operating system junk files
.DS_Store
Thumbs.db

# Ignore targets settings
_targets/